# Copy to a private server.env in this directory. Do not commit real secrets.
# Start-FabVex-Production.ps1 loads this file into the process environment.
FABOS_DATA_DIR=C:\FabVex\Data
FABOS_API_HOST=127.0.0.1
FABOS_API_PORT=8000
# FABOS_API_THREADS=8

# Payment provider:
# All keys below can also be entered in the admin console under Settings >
# Integrations (preferred: masked, admin-gated, no restart needed). Values
# here are a fallback when the settings are empty.
# FABOS_PAYMENT_PROVIDER=stripe
# STRIPE_MODE=test
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
# STRIPE_SECRET_KEY=sk_test_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me
#
# Both redirect URLs are required by FabOS before a Stripe session can be
# created, and both must work without query parameters. The storefront has no
# post-redirect payment handler yet: it does not read "?payment=success", and
# order.html needs an "?id=" that Stripe will not supply. orders.html loads from
# the customer account, so it is the correct landing page for now.
# STRIPE_SUCCESS_URL=https://your-domain.example/orders.html
# STRIPE_CANCEL_URL=https://your-domain.example/checkout.html

# Square (only if you take in-person payments; otherwise leave blank).
# These keys can also be entered in the admin console under Settings >
# Integrations, which is the preferred place for all secrets. Values here
# are a fallback when the settings are empty.
# SQUARE_ACCESS_TOKEN=<secret>
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=<secret>
# SQUARE_WEBHOOK_URL=

# Transactional email (Resend) for customer notifications: quote ready,
# proof awaiting review, payment failed, shipped, cancelled, quote expiring.
# Preferred: enter the key in the admin console under Settings > Integrations
# (masked, admin-gated, no restart needed). Env vars below are a fallback.
# When no key is configured anywhere, notification emails are logged instead
# of sent and the in-app notification center still works.
# RESEND_API_KEY=<secret>
# RESEND_FROM_EMAIL="FABVEX <hello@fabvex.com>"

# Public storefront:
# Not needed for the standard same-origin Caddy deployment, where the storefront
# and API share one hostname and no CORS request is ever made. Set it only if
# the storefront is served from a different origin than the API.
# FABOS_CORS_ORIGINS=https://your-domain.example

# Dynamic DNS, only if using the caddy-dynamicdns app. See DOMAIN_AND_HTTPS.md.
# CLOUDFLARE_API_TOKEN=replace-me
