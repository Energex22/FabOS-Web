# Copy to a private server.env in this directory. Do not commit real secrets.
# Start-FabVex-Production.ps1 loads this file into the process environment.
FABOS_DATA_DIR=C:\FabVex\Data
FABOS_API_HOST=127.0.0.1
FABOS_API_PORT=8000
# FABOS_API_THREADS=8

# Payment provider:
# FABOS_PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=replace-me
# STRIPE_WEBHOOK_SECRET=replace-me
#
# Both redirect URLs are required by FabOS before a Stripe session can be
# created, and both must work without query parameters. The storefront has no
# post-redirect payment handler yet: it does not read "?payment=success", and
# order.html needs an "?id=" that Stripe will not supply. orders.html loads from
# the customer account, so it is the correct landing page for now.
# STRIPE_SUCCESS_URL=https://your-domain.example/orders.html
# STRIPE_CANCEL_URL=https://your-domain.example/checkout.html

# Public storefront:
# Not needed for the standard same-origin Caddy deployment, where the storefront
# and API share one hostname and no CORS request is ever made. Set it only if
# the storefront is served from a different origin than the API.
# FABOS_API_ALLOW_ORIGIN=https://your-domain.example

# Dynamic DNS, only if using the caddy-dynamicdns app. See DOMAIN_AND_HTTPS.md.
# CLOUDFLARE_API_TOKEN=replace-me
