# FabVex production reverse proxy template.
#
# Copy to C:\FabVex\Server\Caddyfile and replace YOUR-DOMAIN before use.
# Adjust the root path if the checkout does not live under C:\FabVex.
#
# Caddy terminates HTTPS automatically and is the only public entry point.
# Keep the FabOS API bound to 127.0.0.1:8000 and never forward port 8000.
#
# See DOMAIN_AND_HTTPS.md for DNS, router, and Windows service setup.

YOUR-DOMAIN {
    encode gzip

    root * C:\FabVex\FabOS-Web\dist

    log {
        output file C:\FabVex\Server\logs\caddy-access.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        try_files {path} {path}/ /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}
